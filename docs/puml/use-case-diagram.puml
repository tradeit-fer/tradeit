
@startuml
title Sustav TradeIt - slučajevi uporabe
left to right direction

skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<external system>> #FFF3CD
    BorderColor<<external system>> #856404
}

skinparam usecase {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}
' Glavni aktori
actor Visitor as "Posjetitelj"
actor User as "Korisnik"
actor Admin as "Admin"

User -|> Visitor
Admin -|> User

Admin -[hidden]down-> User
User -[hidden]down-> Visitor


' Vanjski aktori
actor Auth as "Pružatelj identiteta\n(OAuth)" <<external system>>

rectangle "Sustav TradeIt" {

     ' Pristup
    (UC-01\nPrijava u sustav) as UC_Login

    ' Prijave i karta
    (UC-02\nPregled oglasa) as UC_Browse
    (UC-03\nFiltriranje prikaza objava) as UC_Filter
    (UC-04\nIzraditi objavu) as UC_Create
    (UC-05\nProvjera podataka objave) as UC_ValidatePost
    (UC-06\nDodavanje fotografije) as UC_UploadPhoto
    (UC-07\nPregledati vlastite\nobjave) as UC_MyPosts
    (UC-08\nModeriranje objava) as UC_Moderate
    

}
Admin -- UC_Login
Admin -- UC_Moderate
Visitor -- UC_Login
User -- UC_Browse
User -- UC_Create
User -- UC_MyPosts

Auth -- UC_Login

UC_Create ..> UC_UploadPhoto : <<include>>
UC_Create ..> UC_ValidatePost : <<include>>
UC_Browse ..> UC_Filter : <<extend>>

@enduml
